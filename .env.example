# Backend settings: use your deployed frontend origin in production.
FRONTEND_ORIGIN=http://localhost:3000
PORT=3000
APP_SECRET=replace-with-at-least-32-random-characters

# Required PostgreSQL connection. Keep the real URL private.
# Local example; use your provider's supplied TLS connection URL in production.
DATABASE_URL=postgresql://kaplan:replace-password@127.0.0.1:5432/kaplan
SESSION_IDLE_MINUTES=120
ACCOUNT_LOCK_MINUTES=2
MAX_LOGIN_FAILURES=5

# Optional Google Drive/Docs only. Never required for login.
GOOGLE_ARTIFACTS=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# Only for the one-time migration from the previous local MySQL installation.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=kaplan
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_SSL=false
