# Use http://localhost:3000 locally, or your exact Netlify site URL in production.
FRONTEND_ORIGIN=http://localhost:3000
PORT=3000

# Keep your EXISTING secret when migrating to preserve current sessions.
# For a new installation, generate a random secret of at least 32 characters.
APP_SECRET=replace-with-at-least-32-random-characters

# Reuse the existing values to keep all accounts, results, Docs and recordings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

SESSION_IDLE_MINUTES=120
ACCOUNT_LOCK_MINUTES=2
MAX_LOGIN_FAILURES=5
