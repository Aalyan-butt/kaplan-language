{
  "name": "kaplan-placement",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node app/index.js",
    "dev": "node --watch app/index.js",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check:netlify": "node scripts/check-netlify.mjs",
    "format": "prettier --write app scripts/*.mjs netlify/functions tests/*.js package.json",
    "check:google": "node scripts/check-google.mjs",
    "backfill:reports": "node scripts/backfill-reports.mjs",
    "setup:mysql": "node scripts/setup-mysql.mjs",
    "migrate:mysql": "node scripts/migrate-google-to-mysql.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "googleapis": "^160.0.0",
    "multer": "^2.0.2",
    "mysql2": "^3.24.6",
    "serverless-http": "^4.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@netlify/zip-it-and-ship-it": "^16.6.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10"
  }
}
